{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vayu-webapp",
  "workers_dev": true,
  "compatibility_date": "2026-06-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker.ts",
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application"
  },
  "kv_namespaces": [
    {
      "binding": "VAYU_KV",
      "id": "82eb79f074484b3ba9dc68ba10d0c48b"
    }
  ],
  "r2_buckets": [
    {
      "binding": "VAYU_R2",
      "bucket_name": "vayu-r2-bucket"
    }
  ],
  "d1_databases": [
    {
      "binding": "VAYU_DB",
      "database_name": "vayu-messaging-db",
      "database_id": "33da1221-1883-4220-a193-b4bb40c82d59"
    },
    {
      "binding": "PLATFORM_DB",
      "database_name": "ateliersupport-platform-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "platform/migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "SYNC_HUB", "class_name": "SyncHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SyncHub"] }],
  "analytics_engine_datasets": [{ "binding": "ANALYTICS" }],
  "vars": {
    "WORKSPACE_ID": "default",
    "DELTA_SYNC_ENABLED": "off",
    "REALTIME_ENABLED": "off",
    "FILE_AUTH": "off"
  }
}
