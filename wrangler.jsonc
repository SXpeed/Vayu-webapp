{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vayu-webapp",
  "workers_dev": true,
  // The API. Keeps the name vayu-webapp: the organization databases
  // (Durable Objects) and all secrets belong to this name. The website, the
  // app and the control centre are Workers of their own (frontend/hosts/*,
  // docs/HOSTING.md) that reach this one at /api over a service binding, so it
  // serves no pages itself.
  "routes": [
    // Its own address, for callers outside the browser (payment webhooks).
    { "pattern": "api.ateliersupport.com", "custom_domain": true }
  ],
  "compatibility_date": "2026-06-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "frontend/worker.ts",
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "VAYU_KV",
      "id": "82eb79f074484b3ba9dc68ba10d0c48b"
    }
  ],
  "r2_buckets": [
    {
      "binding": "VAYU_R2",
      "bucket_name": "vayu-r2-bucket"
    }
  ],
  "d1_databases": [
    {
      "binding": "VAYU_DB",
      "database_name": "vayu-messaging-db",
      "database_id": "33da1221-1883-4220-a193-b4bb40c82d59"
    },
    {
      "binding": "PLATFORM_DB",
      "database_name": "ateliersupport-platform-production",
      "database_id": "6589a4b4-e1d3-428c-9a5c-1cc115c87085",
      "migrations_dir": "frontend/platform/migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "SYNC_HUB", "class_name": "SyncHub" },
      // One object (with its own SQLite database) per organization.
      { "name": "ORG_STORE", "class_name": "OrgStore" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SyncHub"] },
    { "tag": "v2", "new_sqlite_classes": ["OrgStore"] }
  ],
  "analytics_engine_datasets": [{ "binding": "ANALYTICS" }],
  // Cloudflare Email Service: sign-up confirmations, password resets,
  // invitations and notices (frontend/platform/email.ts). Sending works once
  // ateliersupport.com is onboarded in the dashboard (Email Service).
  "send_email": [{ "name": "EMAIL" }],
  // Retries notices that could not be sent right away (platform/notify.ts).
  "triggers": { "crons": ["*/10 * * * *"] },
  "ratelimits": [
    { "name": "LOGIN_IP_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "LOGIN_EMAIL_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
    { "name": "API_LIMITER", "namespace_id": "1003", "simple": { "limit": 600, "period": 60 } }
  ],
  "vars": {
    "WORKSPACE_ID": "default",
    "DELTA_SYNC_ENABLED": "on",
    "REALTIME_ENABLED": "on",
    // Private files: /api/files/* needs the app's sign-in or its file cookie
    // (frontend/fileAuth.ts); an address alone opens nothing.
    "FILE_AUTH": "on",
    // Plain vars, not secrets: committed here (not set via the dashboard)
    // so they survive every deploy instead of being wiped by the next one.
    // Every address whose Worker hands /api to this one, so Better Auth
    // accepts a sign-in from any of them.
    "AUTH_ORIGINS": "https://ateliersupport.com,https://www.ateliersupport.com,https://app.ateliersupport.com,https://admin.ateliersupport.com",
    // The control centre only answers on this host; every other host gets
    // a plain 404 on /api/v2/admin/*. The platform database still needs to
    // exist for the control centre to actually work (see docs/PENDING.md §2).
    "ADMIN_HOST": "admin.ateliersupport.com",
    // Where outside callers reach the API (the Razorpay webhook address the
    // control centre shows). docs/HOSTING.md.
    "API_ORIGIN": "https://api.ateliersupport.com",
    // Sender for every email; must be on the onboarded domain.
    "EMAIL_FROM": "no-reply@ateliersupport.com"
  }
}
