{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vayu-webapp",
  "workers_dev": true,
  "routes": [
    { "pattern": "ateliersupport.com", "custom_domain": true },
    // www should 301 to the apex via a Cloudflare Redirect Rule, so logins,
    // the installed PWA and push subscriptions stay on one origin.
    { "pattern": "www.ateliersupport.com", "custom_domain": true }
  ],
  "compatibility_date": "2026-06-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "frontend/worker.ts",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "frontend/dist",
    "not_found_handling": "single-page-application"
  },
  "kv_namespaces": [
    {
      "binding": "VAYU_KV",
      "id": "82eb79f074484b3ba9dc68ba10d0c48b"
    }
  ],
  "r2_buckets": [
    {
      "binding": "VAYU_R2",
      "bucket_name": "vayu-r2-bucket"
    }
  ],
  "d1_databases": [
    {
      "binding": "VAYU_DB",
      "database_name": "vayu-messaging-db",
      "database_id": "33da1221-1883-4220-a193-b4bb40c82d59"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "SYNC_HUB", "class_name": "SyncHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SyncHub"] }],
  "analytics_engine_datasets": [{ "binding": "ANALYTICS" }],
  "vars": {
    "WORKSPACE_ID": "default",
    "DELTA_SYNC_ENABLED": "on",
    "REALTIME_ENABLED": "on",
    "FILE_AUTH": "off"
  }
}
